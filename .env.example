# Copy this file to .env.local. In demo mode (the default) you need NO keys at
# all — just copy and run. Fill in real keys only to run live. Never commit .env.local.

# Agentic "brain" — provide EITHER key (Claude preferred when both are set).
# Anthropic (Claude Opus 4.8): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI (GPT function calling; model via OPENAI_MODEL, default gpt-4o):
OPENAI_API_KEY=
OPENAI_MODEL=

# YouCam / Perfect Corp AI API — skin analysis + apparel VTO, etc. Needed only
# for LIVE renders (set YOUCAM_FIXTURES=0 below). Register (free 1,000 units) at
# https://yce.perfectcorp.com/api-console/en/api-keys/
YOUCAM_API_KEY=

# --- Optional / advanced (leave blank unless YouCam v2 requires the legacy
# client-id + secret token-exchange flow instead of a direct Bearer key) ---
YOUCAM_CLIENT_ID=
YOUCAM_CLIENT_SECRET=

# REST API base (default is correct; override only if Perfect Corp changes it).
# The app drives YouCam entirely over this REST API — the agentic engine calls
# it via Claude's typed function-calling tools, not via an MCP server at runtime.
YOUCAM_API_BASE=https://yce-api-01.perfectcorp.com

# --- Cost control ---
# Demo mode: serve captured fixture renders (public/fixtures/*) instead of
# calling YouCam, so the whole app runs with ZERO API units — and with no keys
# at all. ON by default so a fresh clone works out of the box. Set to 0 to spend
# units on live renders of your own photo (e.g. the final demo recording).
YOUCAM_FIXTURES=1

# (The "Agentic" engine toggle unlocks automatically when ANTHROPIC_API_KEY or
# OPENAI_API_KEY is set — derived server-side in app/page.tsx, no flag needed.)

# --- Judge mode: who may spend money, and how much -------------------------
# The product works fully without any of this — visitors get captured sample
# renders at zero API cost. These variables gate only the paths that spend:
# real YouCam renders and the LLM-driven engine.
#
# The gate is OFF unless BOTH of the next two are set. That is what keeps local
# development and the test suite ungated with no special case in the code.
# Comma-separated role:code pairs.
APHRODITE_LIVE_CODES=
# Signing key for the access cookie. Rotating it invalidates every issued cookie.
APHRODITE_AUTH_SECRET=
# Hard ceiling on live runs, because a code answers WHO may spend, not HOW MANY
# times. One full run costs 4-5 YouCam API tasks. When the budget is gone the app
# falls back to captured samples and says so on screen. Default 20.
APHRODITE_LIVE_RUN_BUDGET=
# Where the run count is kept. Default /var/lib/aphrodite/ledger.json
APHRODITE_LEDGER_PATH=

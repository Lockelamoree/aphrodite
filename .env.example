# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Agentic "brain" — provide EITHER key (Claude preferred when both are set).
# Anthropic (Claude Opus 4.8): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# OpenAI (GPT function calling; model via OPENAI_MODEL, default gpt-4o):
OPENAI_API_KEY=
OPENAI_MODEL=

# YouCam / Perfect Corp AI API — skin analysis + apparel VTO, etc.
# Register (free 1,000 units) and create a key at
# https://yce.perfectcorp.com/api-console/en/api-keys/
YOUCAM_API_KEY=

# --- Optional / advanced (leave blank unless YouCam v2 requires the legacy
# client-id + secret token-exchange flow instead of a direct Bearer key) ---
YOUCAM_CLIENT_ID=
YOUCAM_CLIENT_SECRET=

# REST API base (default is correct; override only if Perfect Corp changes it).
# The app drives YouCam entirely over this REST API — the agentic engine calls
# it via Claude's typed function-calling tools, not via an MCP server at runtime.
YOUCAM_API_BASE=https://yce-api-01.perfectcorp.com

# --- Cost control ---
# Replay mode: serve captured fixture renders (public/fixtures/*) instead of
# calling YouCam, so dev + demo rehearsal consume ZERO API units. Set to 1 while
# iterating; leave blank/0 for real renders (e.g. the final demo recording).
YOUCAM_FIXTURES=

# Set to 1 ONLY when an LLM key (ANTHROPIC_API_KEY or OPENAI_API_KEY) is filled
# in — this un-hides the "Agentic" engine toggle in the UI. Leave blank when
# running guided/YouCam-only. (NEXT_PUBLIC_HAS_ANTHROPIC=1 still works too.)
NEXT_PUBLIC_HAS_AGENTIC=

[Unit]
Description=Aphrodite occasion concierge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aphrodite
Group=aphrodite
# /opt/aphrodite is a symlink into an immutable /opt/aphrodite-releases/<sha>-<ts>.
# The deploy flips the symlink and restarts, so a rollback is just flipping it back.
WorkingDirectory=/opt/aphrodite
EnvironmentFile=/etc/aphrodite.env
ExecStart=/usr/bin/node /opt/aphrodite/node_modules/.bin/next start --port ${PORT}
Restart=on-failure
RestartSec=3

# Sandboxing. The app needs no write access anywhere: Next.js serves a prebuilt
# .next, and nothing is persisted — the saved plan lives in the visitor's own
# localStorage, not on the server.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/opt/aphrodite-releases
# AF_NETLINK is required, and leaving it out cost a deploy to diagnose.
# On startup Next.js enumerates network interfaces to print the LAN URL, which on
# Linux goes through a netlink socket. Without AF_NETLINK that call fails with
# EAFNOSUPPORT (errno 97) as an UNHANDLED REJECTION at the `listening` event — so
# the socket ends up bound and listening while the request handler is never wired
# up. The service reports active, `ss` shows it listening, and every request just
# hangs until the proxy times out: status 0, size 0, no error anywhere.
#
# Verified by bisection: the identical command outside the sandbox answered
# /healthz in 1s; inside it, never.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictSUIDSGID=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
